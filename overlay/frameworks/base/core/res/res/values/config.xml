<resources>
    <!-- Autoradio : pas de touches materielles Android, barre de navigation a l'ecran -->
    <bool name="config_showNavigationBar">true</bool>

    <!-- Pas de capteur de lumiere ambiante -->
    <bool name="config_automatic_brightness_available">false</bool>

    <!-- Ecran fixe en paysage -->
    <bool name="config_supportAutoRotation">false</bool>

    <!-- Alimente par le vehicule : ne pas rallumer l'ecran sur un changement d'alimentation -->
    <bool name="config_unplugTurnsOnScreen">false</bool>

    <!-- Reseau filaire : eth* (adaptateurs Ethernet USB, iPhone) et usb* (partage de connexion USB d'un telephone
         Android, RNDIS ou NCM, que Linux nomme usb0). Android 9 ne prend que "eth\d" par defaut : le partage d'un
         telephone Android etait ignore. Meme valeur que le defaut d'Android 15 ; zip usb-tethering pour le stock. -->
    <string name="config_ethernet_iface_regex" translatable="false">(eth|usb)\\d+</string>
</resources>
