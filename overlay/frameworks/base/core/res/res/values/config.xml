<resources>
    <!-- Autoradio : pas de touches materielles Android, barre de navigation a l'ecran -->
    <bool name="config_showNavigationBar">true</bool>

    <!-- Pas de capteur de lumiere ambiante -->
    <bool name="config_automatic_brightness_available">false</bool>

    <!-- Ecran fixe en paysage -->
    <bool name="config_supportAutoRotation">false</bool>

    <!-- Alimente par le vehicule : ne pas rallumer l'ecran sur un changement d'alimentation -->
    <bool name="config_unplugTurnsOnScreen">false</bool>

    <!-- Reseau filaire : eth* (adaptateurs Ethernet USB, iPhone) et usb* (partage de connexion USB d'un telephone
         Android, RNDIS ou NCM, que Linux nomme usb0). Android 9 ne prend que "eth\d" par defaut : le partage d'un
         telephone Android etait ignore. Meme valeur que le defaut d'Android 15 ; zip usb-tethering pour le stock. -->
    <string name="config_ethernet_iface_regex" translatable="false">(eth|usb)\\d+</string>
    <!-- Wi-Fi bi-bande (puce MediaTek connac gen4m : 2,4 et 5 GHz, association vue en 5 GHz canal 100). Android 9 et 10
         repondent a WifiManager.is5GHzBandSupported() / isDualBandSupported() avec ce seul reglage
         (WifiServiceImpl.isDualBandSupported, android10-release), faux par defaut dans AOSP : applis et point d'acces
         (bande 5 GHz) croyaient la puce limitee au 2,4 GHz. -->
    <bool translatable="false" name="config_wifi_dual_band_support">true</bool>
    <!-- LibreHU : acces aux notifications des applis LibreHU des le premier demarrage, sans demande (titre en cours du
         Launcher, EasySource, clignotement des LED du service) ; librehu_grants l'accorde ensuite a chaque demarrage. -->
    <string name="config_defaultListenerAccessPackages" translatable="false">org.librehu.launcher:org.librehu.easysource:org.librehu.service</string>

    <!-- Telephonie des cartes « +4G » (RIL MediaTek du vendor, mtkfusionrild) : reglages generaux du RRO MediaTek du
         vendor stock (framework-res__auto_generated_rro.apk, retire par le zip de la ROM), comme le stock. SIM inseree
         ou retiree a chaud (le RIL MediaTek le gere) ; pas de changement GSM / CDMA du telephone d'Android sur un
         changement de reseau voix (le modem le fait lui-meme) ; agent MMS. Reglages par operateur dans les dossiers
         values-mccNNN ; VoLTE / IMS pas repris (pas de pile IMS). Android 11 et plus : les interfaces de partage de
         connexion sont dans overlay-rro/LibreHUTetheringOverlay (module Tethering) et la recherche Wi-Fi de fond dans
         overlay-rro/LibreHUWifiOverlay (com.android.wifi.resources). -->
    <bool name="config_hotswapCapable">true</bool>
    <bool name="config_switch_phone_on_voice_reg_state_change">false</bool>
    <string name="config_mms_user_agent" translatable="false">Android-Mms/0.1</string>
    <string name="config_mms_user_agent_profile_url" translatable="false">http://www.google.com/oha/rdf/ua-profile-kila.xml</string>

    <!-- Reglage du meme RRO, vrai pour ce materiel : le compositeur materiel MediaTek applique la matrice de couleur
         (Night Light, LiveDisplay) sans passer par le GPU. -->
    <bool name="config_setColorTransformAccelerated">true</bool>
</resources>
