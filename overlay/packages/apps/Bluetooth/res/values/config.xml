     Profils Bluetooth d'un autoradio, ceux de la voiture de reference d'Android 10
     (packages/services/Car, car_product/overlay/packages/apps/Bluetooth/res/values/config.xml, lineage-17.1, liste
     identique a celle de pie-release) : l'autoradio est le cote voiture (HFP client, A2DP sink, AVRCP controleur,
     PBAP / MAP client), pas un telephone. Classe d'appareil « Car audio » et A2DP sink compile :
     bluetooth/bdroid_buildcfg.h.
-->
<resources>
    <!-- Roles d'un telephone, coupes (profile_supported_hdp : HDP n'existe plus dans Android 10, gardee comme dans
         la voiture de reference) -->
    <bool name="profile_supported_a2dp">false</bool>
    <bool name="profile_supported_hs_hfp">false</bool>
    <bool name="profile_supported_pbap">false</bool>
    <bool name="profile_supported_map">false</bool>
    <bool name="profile_supported_hdp">false</bool>
    <bool name="profile_supported_opp">false</bool>
    <bool name="enable_phone_policy">false</bool>

    <!-- Roles d'une voiture : appels (HFP client, relie a Telecom comme le dialer LibreHU l'attend), musique (A2DP
         sink, AVRCP controleur), repertoire et messages (PBAP client, MAP client), partage de connexion (PAN) -->
    <bool name="profile_supported_hfpclient">true</bool>
    <bool name="hfp_client_connection_service_enabled">true</bool>
    <bool name="profile_supported_avrcp_controller">true</bool>
    <bool name="profile_supported_a2dp_sink">true</bool>
    <bool name="profile_supported_pbapclient">true</bool>
    <bool name="profile_supported_pan">true</bool>
    <bool name="profile_supported_mapmce">true</bool>

    <!-- Telecommandes, claviers, souris et manettes Bluetooth (HID host, HID sur GATT pour le BLE) : la voiture de
         reference le coupe, mais rien d'autre ne les connecte (18/11/2026 : une telecommande TV BLE s'appairait, puis
         Android ne tentait que HFP et A2DP, sans HID). Le noyau a UHID et les pilotes de manettes. -->
    <bool name="profile_supported_hid_host">true</bool>

    <!-- Musique Bluetooth : l'autoradio prend le focus audio quand le telephone lance la lecture (A2dpSinkStreamHandler,
         SRC_STR_START et SRC_PLAY, shouldRequestFocus). A false (valeur d'Android 10), seuls une TV ou un objet
         connecte le prennent, et le son du telephone est jete (musique muette, logcat du 14/11/2026 sous LineageOS
         16.0, ou la branche lineage-16.0 corrige le code de l'appli pour la meme chose). -->
    <bool name="a2dp_sink_automatically_request_audio_focus">true</bool>
</resources>
