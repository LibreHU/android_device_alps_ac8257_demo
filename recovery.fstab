# TWRP fstab - Jancar UJC201 / AC8257 (carte JAC_8258C)
# mount point   fstype  device                       [device2]                flags

# Partitions systeme
#/system_root    ext4    /dev/block/platform/bootdevice/by-name/system                                     flags=display="System";backup=1;wipeingui
/system_root    ext4    /dev/block/platform/bootdevice/by-name/system                                     flags=display="System (fichiers)";backup=1;wipeingui
/system_image   emmc    /dev/block/platform/bootdevice/by-name/system                                     flags=display="System Image";backup=1;flashimg=1
/vendor         ext4    /dev/block/platform/bootdevice/by-name/vendor                                     flags=display="Vendor";backup=1;wipeingui
/cache          ext4    /dev/block/platform/bootdevice/by-name/cache                                      flags=display="Cache";backup=1
/data           ext4    /dev/block/platform/bootdevice/by-name/userdata                                   flags=encryptable=footer;length=-16384

# Donnees propres a l'unite (a sauvegarder absolument)
/jancar         ext4    /dev/block/platform/bootdevice/by-name/jancar                                     flags=display="Jancar (config)";backup=1
/nvdata         ext4    /dev/block/platform/bootdevice/by-name/nvdata                                     flags=display="NVdata";backup=1
/nvcfg          ext4    /dev/block/platform/bootdevice/by-name/nvcfg                                      flags=display="NVcfg";backup=1
/protect_f      ext4    /dev/block/platform/bootdevice/by-name/protect1                                   flags=display="Protect_f";backup=1
/protect_s      ext4    /dev/block/platform/bootdevice/by-name/protect2                                   flags=display="Protect_s";backup=1
/persist        ext4    /dev/block/platform/bootdevice/by-name/persist                                    flags=display="Persist";backup=1
/nvram          emmc    /dev/block/platform/bootdevice/by-name/nvram                                      flags=display="NVRAM";backup=1
/proinfo        emmc    /dev/block/platform/bootdevice/by-name/proinfo                                    flags=display="Proinfo";backup=1
/metazone       emmc    /dev/block/platform/bootdevice/by-name/metazone                                   flags=display="Metazone (ecran)";backup=1
/logo           emmc    /dev/block/platform/bootdevice/by-name/logo                                       flags=display="Logo";backup=1;flashimg=1

# Images de demarrage
/boot           emmc    /dev/block/platform/bootdevice/by-name/boot                                       flags=display="Boot";backup=1;flashimg=1
/recovery       emmc    /dev/block/platform/bootdevice/by-name/recovery                                   flags=display="Recovery";backup=1;flashimg=1
/dtbo           emmc    /dev/block/platform/bootdevice/by-name/dtbo                                       flags=display="DTBO";backup=1;flashimg=1
/vbmeta         emmc    /dev/block/platform/bootdevice/by-name/vbmeta                                     flags=display="VBMeta";backup=1;flashimg=1

# Firmware bas niveau (flash possible, pas de sauvegarde par defaut)
/lk             emmc    /dev/block/platform/bootdevice/by-name/lk                                         flags=display="LK";flashimg=1
/lk2            emmc    /dev/block/platform/bootdevice/by-name/lk2                                        flags=display="LK2";flashimg=1
/tee1           emmc    /dev/block/platform/bootdevice/by-name/tee1                                       flags=display="TEE1";flashimg=1
/tee2           emmc    /dev/block/platform/bootdevice/by-name/tee2                                       flags=display="TEE2";flashimg=1
/scp1           emmc    /dev/block/platform/bootdevice/by-name/scp1
/scp2           emmc    /dev/block/platform/bootdevice/by-name/scp2
/sspm_1         emmc    /dev/block/platform/bootdevice/by-name/sspm_1
/sspm_2         emmc    /dev/block/platform/bootdevice/by-name/sspm_2
/spmfw          emmc    /dev/block/platform/bootdevice/by-name/spmfw
/md1img         emmc    /dev/block/platform/bootdevice/by-name/md1img
/arm2           emmc    /dev/block/platform/bootdevice/by-name/arm2
/misc           emmc    /dev/block/platform/bootdevice/by-name/para
/expdb          emmc    /dev/block/platform/bootdevice/by-name/expdb
/seccfg         emmc    /dev/block/platform/bootdevice/by-name/seccfg

# Preloader (zone BOOT1 de l'eMMC) : sauvegarde seulement, ne JAMAIS restaurer depuis TWRP
/preloader      emmc    /dev/block/mmcblk0boot0                       flags=display="Preloader (lecture seule)";backup=1

# Stockages amovibles
/external_sd    auto    /dev/block/mmcblk1p1    /dev/block/mmcblk1    flags=display="MicroSD";storage;wipeingui;removable
/usb_otg        auto    /dev/block/sda1         /dev/block/sda        flags=display="USB";storage;wipeingui;removable
/usb_otg2       auto    /dev/block/sdb1         /dev/block/sdb        flags=display="USB 2";storage;wipeingui;removable
