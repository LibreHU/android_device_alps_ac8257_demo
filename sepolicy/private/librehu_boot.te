#
# librehu_boot : petits services de demarrage de la ROM lances en root par l'init (librehu/ksugrant : root de
# KernelSU Next accorde a LibreHU-service ; librehu/boot : pays du Wi-Fi d'apres la langue). Domaine propre pour la
# meme raison que mcu_ready (l'init d'Android 9 refuse un service sans transition de domaine, meme en permissif) ;
# permissif a lui seul en attendant le passage en enforcing (userdebug seulement).
type librehu_boot, domain, coredomain;
type librehu_boot_exec, exec_type, file_type;

init_daemon_domain(librehu_boot)
permissive librehu_boot;
