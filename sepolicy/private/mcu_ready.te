#
# mcu_ready (mcu_ready/) : PC_READY au MCU Jancar des le demarrage, sans quoi le MCU coupe le SoC une dizaine de
# secondes apres. Un domaine propre est obligatoire : l'init d'Android 9 refuse de lancer un service dont le binaire
# n'a pas de transition de domaine (« has incorrect label or no domain transition »), meme en SELinux permissif
# (system/core/init/service.cpp, ComputeContextFromExecutable). SELinux reste permissif (BoardConfig.mk) : les
# regles d'acces au port serie viendront avec le passage en enforcing (Roadmap, point 4).
type mcu_ready, domain, coredomain;
type mcu_ready_exec, exec_type, file_type;

init_daemon_domain(mcu_ready)
