# Droits de noeuds de peripheriques que le system stock (system-as-root, remplace par celui de LineageOS) donnait aux
# services du vendor, et que ni le /ueventd.rc de LineageOS ni le /vendor/ueventd.rc stock ne couvrent. ueventd lit ce
# fichier apres eux (/ueventd.<ro.hardware>.rc, ro.hardware=ac8257 : system/core/init/ueventd.cpp) ; un noeud sans
# regle est cree en 0600 root root (devices.cpp, GetDevicePermissions).

# Pilote backcar (drivers/misc/autochips/backcar du noyau) : le HAL vendor.autochips.hardware.backcar@1.0
# (backcar_daemon, user system) l'ouvre a son demarrage. Sans acces (journal du 13/11/2026 : « open /dev/backcardrv
# fail. Permission denied »), sendReadyToArm2() rend 1 sans rien faire : l'ARM2 garde ses deux couches d'affichage et
# la video decodee par le materiel reste verte jusqu'a la premiere veille.
/dev/backcardrv           0660   system     system

# Pilote GPIO Jancar (drivers/misc/jancar/jancar_gpios.c du noyau) : LibreHU-service l'ouvre directement, avec l'UID
# de son appli (librehu_hw.c), pour la sourdine de l'ampli (GPIO 166, 1 = muet), le commutateur video CVBS et les
# entrees. Le system stock le donnait a tout le monde (crwxrwxrwx, ivi-services tourne en system) ; sans regle, le
# service ne peut rien piloter et l'ampli reste muet : aucun son (rapport de Reo Au In du 13/11/2026, confirme sur
# l'unite par chmod 0660 + bascule de la sourdine). L'UID de l'appli change d'une installation a l'autre : droits du
# stock. Pour SELinux enforcing, il faudra en plus un type de peripherique et des regles allow.
/dev/gpios_ioctl          0666   root       root

# Desentrelaceur video Autochips (drivers/misc/autochips/di du noyau : entree video CVBS, cameras) : regle du
# /ueventd.rc stock, absente de celui de LineageOS (comparaison du 14/11/2026 avec le dump SP Flash Tool du stock).
/dev/di                   0666   system     system

# Bus I2C : le system stock les ouvrait tous (init.jancar.rc, « on boot » : chmod 777 + chown system de /dev/i2c-0 a
# i2c-6). Le /vendor/ueventd.rc stock ne couvre que i2c-1 et i2c-6 (puce audio BD37534). LibreHU CarPlay cherche la
# puce MFi sur chaque /dev/i2c-N qu'il peut ouvrir (adresses 0x10 / 0x11) : sans ces regles, une puce sur un autre bus
# reste introuvable.
/dev/i2c-0                0666   system     system
/dev/i2c-2                0666   system     system
/dev/i2c-3                0666   system     system
/dev/i2c-4                0666   system     system
/dev/i2c-5                0666   system     system
