#!/sbin/sh
# UJC201 build.prop fix (zip TWRP)
# Le firmware Jancar annonce une fausse version dans /system/build.prop :
#   ro.build.version.release=12 (SDK 28 = Android 9) et le fingerprint d'une autre plateforme
#   (alps/full_evb3561sv_w_65_m0/...:6.0/MRA58K/...).
# Les vraies valeurs sont reprises du fingerprint de /vendor/build.prop (ro.vendor.build.fingerprint) :
#   ro.build.version.release, ro.build.fingerprint, ro.build.description.
# Le framework Jancar (ActivityThread.bindApplication) reecrit Build.VERSION.RELEASE : "12" pour les Reglages
# Android tant que persist.jancar.ver_rel est vide, SDK 31 pour les benchmarks (persist.jancar.sdk).
# Neutralise par persist.jancar.ver_rel=<release> et persist.jancar.sdk=<sdk> :
#   - dans build.prop (valeurs par defaut, gardees apres un reset de /data) ;
#   - /system/etc/init/ujc201_version.rc : reimpose a chaque demarrage (ecrase une valeur enregistree dans /data).
# Sauvegarde de chaque fichier modifie : <fichier>.bak a cote (garde l'original s'il existe deja)
# + copie dans /sdcard/UJC201_buildprop_backup/<date>/ (meme arborescence).
# Retour : zip ujc201_buildprop_restore.

OUTFD=$2
ui_print() { echo "ui_print $1" > /proc/self/fd/$OUTFD; echo "ui_print" > /proc/self/fd/$OUTFD; }
abort() { ui_print "ERROR: $1"; cleanup; exit 1; }

BYNAME=/dev/block/platform/bootdevice/by-name
SYSMNT=${UJC_SYSMNT:-/system_root}
VENMNT=${UJC_VENMNT:-/vendor}
SDCARD=${UJC_SDCARD:-/data/media/0}
MOUNTED_SYS=0; MOUNTED_VEN=0

cleanup() {
	[ -n "$UJC_TEST" ] && return
	[ $MOUNTED_VEN = 1 ] && umount $VENMNT 2>/dev/null
	umount $SYSMNT 2>/dev/null
}

prop() { grep -m1 "^$1=" "$2" 2>/dev/null | cut -d= -f2-; }

ui_print "UJC201 - build.prop fix (Android version / fingerprint)"
ui_print "-------------------------------------------------------"

# --- montages : system en lecture-ecriture, vendor en lecture seule
if [ -z "$UJC_TEST" ]; then
	umount $SYSMNT 2>/dev/null; umount /system 2>/dev/null
	mkdir -p $SYSMNT
	blockdev --setrw $BYNAME/system 2>/dev/null
	mount -t ext4 -o rw $BYNAME/system $SYSMNT || abort "cannot mount system"
	if ! grep -q " $VENMNT " /proc/mounts; then
		mkdir -p $VENMNT
		mount -t ext4 -o ro $BYNAME/vendor $VENMNT || abort "cannot mount vendor"
		MOUNTED_VEN=1
	fi
	[ -d $SDCARD ] || abort "internal storage not mounted (/data decrypted?): no backup copy possible"
fi

# --- valeurs de reference : fingerprint vendor
VFP=$(prop ro.vendor.build.fingerprint $VENMNT/build.prop)
[ -n "$VFP" ] || abort "ro.vendor.build.fingerprint not found in $VENMNT/build.prop"
# brand/name/device:release/id/incremental:type/tags
NAME=$(echo "$VFP" | cut -d/ -f2)
REL=$(echo "$VFP" | cut -d: -f2 | cut -d/ -f1)
BID=$(echo "$VFP" | cut -d/ -f4)
INC=$(echo "$VFP" | cut -d/ -f5 | cut -d: -f1)
TYPE=$(echo "$VFP" | cut -d: -f3 | cut -d/ -f1)
TAGS=$(echo "$VFP" | cut -d/ -f6)
DESC="$NAME-$TYPE $REL $BID $INC $TAGS"
case "$REL" in ''|*[!0-9.]*) abort "unexpected vendor fingerprint: $VFP";; esac
ui_print "Reference (vendor): $VFP"

# --- fichiers a corriger : build.prop du system (fichiers reguliers uniquement)
FILES=""
for f in $SYSMNT/system/build.prop $SYSMNT/build.prop; do
	[ -f "$f" ] && [ ! -L "$f" ] && grep -q '^ro.build.fingerprint=' "$f" && FILES="$FILES $f"
done
[ -n "$FILES" ] || abort "no build.prop found in $SYSMNT"

# espace libre (sauvegarde .bak a cote)
FREE=$(df -k $SYSMNT 2>/dev/null | tail -n1 | awk '{print $4}')
[ -n "$FREE" ] && [ "$FREE" -lt 64 ] && abort "system partition full (${FREE} KB free)"

STAMP=$(date +%Y%m%d-%H%M%S)
BKDIR=$SDCARD/UJC201_buildprop_backup/$STAMP
CHANGED=0

TMP=/tmp/ujc201_buildprop.$$
for f in $FILES; do
	ui_print " "
	ui_print "$f"
	SDK=$(prop ro.build.version.sdk "$f"); [ -n "$SDK" ] || SDK=28
	# contenu cible : 3 lignes corrigees + valeurs persist.jancar.* (neutralisent la fausse version du framework)
	sed -e "s|^ro.build.version.release=.*|ro.build.version.release=$REL|" \
	    -e "s|^ro.build.fingerprint=.*|ro.build.fingerprint=$VFP|" \
	    -e "s|^ro.build.description=.*|ro.build.description=$DESC|" \
	    -e "s|^persist.jancar.ver_rel=.*|persist.jancar.ver_rel=$REL|" \
	    -e "s|^persist.jancar.sdk=.*|persist.jancar.sdk=$SDK|" "$f" > $TMP || abort "sed"
	if ! grep -q '^persist.jancar.ver_rel=' $TMP; then
		{ echo ""; echo "# UJC201 fix: real Android version (the Jancar framework reports 12 / SDK 31 otherwise)"
		  echo "persist.jancar.ver_rel=$REL"; } >> $TMP
	fi
	grep -q '^persist.jancar.sdk=' $TMP || echo "persist.jancar.sdk=$SDK" >> $TMP
	[ -s $TMP ] || abort "empty result, file not changed"
	if cmp -s $TMP "$f"; then ui_print "  already fixed, nothing to do"; continue; fi
	ui_print "  release:     $(prop ro.build.version.release "$f") -> $REL"
	ui_print "  fingerprint: $(prop ro.build.fingerprint "$f")"
	ui_print "             -> $VFP"
	ui_print "  description: $(prop ro.build.description "$f") -> $DESC"
	ui_print "  persist.jancar.ver_rel=$REL  persist.jancar.sdk=$SDK"

	# sauvegardes (avant toute modification)
	if [ -f "$f.bak" ]; then
		ui_print "  $f.bak already there: kept (original)"
	else
		cp -p "$f" "$f.bak" || abort "cannot copy $f.bak"
		ui_print "  backup:     $f.bak"
	fi
	mkdir -p "$BKDIR$(dirname "$f")" || abort "cannot create folder $BKDIR"
	cp -p "$f" "$BKDIR$f" || abort "cannot copy to internal storage"
	ui_print "  copy:       $BKDIR$f"

	# reecriture sur place (garde inode, droits et contexte SELinux)
	cat $TMP > "$f" || abort "cannot write $f (restore $f.bak)"
	sync
	cmp -s $TMP "$f" || abort "check failed: restore $f.bak"
	ui_print "  OK"
	CHANGED=$((CHANGED + 1))
done
rm -f $TMP

# --- service init : reimpose les valeurs a chaque demarrage (ecrase une valeur deja enregistree dans /data)
RC=$SYSMNT/system/etc/init/ujc201_version.rc
SDK=$(prop ro.build.version.sdk $(echo $FILES | cut -d' ' -f1)); [ -n "$SDK" ] || SDK=28
RCTXT="# UJC201 fix: real Android version at each boot (Jancar framework, ActivityThread)
on property:sys.boot_completed=1
    setprop persist.jancar.ver_rel $REL
    setprop persist.jancar.sdk $SDK"
ui_print " "
if [ -f "$RC" ] && [ "$(cat "$RC")" = "$RCTXT" ]; then
	ui_print "$RC: already there"
elif [ -d "$(dirname "$RC")" ]; then
	[ -f "$RC" ] && ST=updated || ST=created
	echo "$RCTXT" > "$RC" || abort "cannot write $RC"
	chmod 0644 "$RC"; chown 0:0 "$RC" 2>/dev/null
	[ -z "$UJC_TEST" ] && chcon u:object_r:system_file:s0 "$RC" 2>/dev/null
	ui_print "$RC: $ST"
	CHANGED=$((CHANGED + 1))
else
	ui_print "WARNING: $(dirname "$RC") missing, init service not installed"
fi

ui_print " "
if [ $CHANGED -gt 0 ]; then
	ui_print "$CHANGED file(s) fixed. Backup: $BKDIR"
else
	ui_print "No change."
fi
ui_print "To go back: flash ujc201_buildprop_restore.zip"
cleanup
exit 0
