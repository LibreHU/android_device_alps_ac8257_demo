+// LibreHU (UJC201) : rotation de la dalle appliquee par SurfaceFlinger (services/surfaceflinger/SurfaceFlinger.cpp),
+// en orientation d'affichage (quarts de tour).
+static int32_t librehuDisplayRotation() {
+    char value[PROPERTY_VALUE_MAX];
+    property_get("persist.librehu.display_rotation", value, "");
+    if (value[0] == '\0') {
+        property_get("ro.librehu.display_rotation", value, "0");
+    }
+    switch (atoi(value)) {
+        case 90:
+            return DISPLAY_ORIENTATION_90;
+        case 180:
+            return DISPLAY_ORIENTATION_180;
+        case 270:
+            return DISPLAY_ORIENTATION_270;
+        default:
+            return DISPLAY_ORIENTATION_0;
+    }
+}
