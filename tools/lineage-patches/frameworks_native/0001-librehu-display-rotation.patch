@@ -315,6 +315,33 @@
             SurfaceFlinger::primaryDisplayOrientation = DisplayState::eOrientationDefault;
             break;
     }
+    // LibreHU (UJC201) : dalle 720 x 1280 montee en paysage. Le stock la tourne avec persist.sf.hwrotation=90 (propriete
+    // du SurfaceFlinger de MediaTek, ignoree ici) et le configstore du vendor stock rend 0. Rotation lue dans
+    // persist.librehu.display_rotation, sinon ro.librehu.display_rotation : 0, 90, 180 ou 270 ; l'InputReader tourne
+    // le tactile d'autant (services/inputflinger/InputReader.cpp).
+    {
+        char librehuRotation[PROPERTY_VALUE_MAX];
+        property_get("persist.librehu.display_rotation", librehuRotation, "");
+        if (librehuRotation[0] == '\0') {
+            property_get("ro.librehu.display_rotation", librehuRotation, "");
+        }
+        if (librehuRotation[0] != '\0') {
+            switch (atoi(librehuRotation)) {
+                case 90:
+                    SurfaceFlinger::primaryDisplayOrientation = DisplayState::eOrientation90;
+                    break;
+                case 180:
+                    SurfaceFlinger::primaryDisplayOrientation = DisplayState::eOrientation180;
+                    break;
+                case 270:
+                    SurfaceFlinger::primaryDisplayOrientation = DisplayState::eOrientation270;
+                    break;
+                default:
+                    SurfaceFlinger::primaryDisplayOrientation = DisplayState::eOrientationDefault;
+                    break;
+            }
+        }
+    }
     ALOGV("Primary Display Orientation is set to %2d.", SurfaceFlinger::primaryDisplayOrientation);
 
