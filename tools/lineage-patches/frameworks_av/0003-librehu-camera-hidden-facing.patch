+// librehuCameraHiddenFacing (LibreHU, UJC201): the Jancar camera HAL declares ids without a camera behind them (no
+// MIPI sensor for "2", "10", "11", "12" on most units: open fails with -38) and calls every camera "back" but one.
+// Apps that take "the first back / front camera" (Camera2) then open a dead one. Set by LibreHU-service, which
+// restarts cameraserver to apply them:
+//   persist.librehu.camera.hidden  ids not shown to apps, "2,10,11,12"
+//   persist.librehu.camera.facing  facing given to ids, "3:back,0:front,8:external"
+// Unset: nothing changes.
+static std::string librehuCameraProperty(const char* key) {
+    char value[PROPERTY_VALUE_MAX];
+    property_get(key, value, "");
+    return std::string(value);
+}
+
+// true when the comma list holds id (as "id" or "id:arg"); arg gets what follows the colon
+static bool librehuCameraListed(const std::string& list, const std::string& id, std::string* arg) {
+    size_t start = 0;
+    while (start < list.size()) {
+        size_t end = list.find(',', start);
+        if (end == std::string::npos) end = list.size();
+        std::string item = list.substr(start, end - start);
+        size_t first = item.find_first_not_of(" \t");
+        item = first == std::string::npos ? "" : item.substr(first, item.find_last_not_of(" \t") - first + 1);
+        size_t colon = item.find(':');
+        if (!item.empty() && item.substr(0, colon) == id) {
+            if (arg != nullptr) *arg = colon == std::string::npos ? "" : item.substr(colon + 1);
+            return true;
+        }
+        start = end + 1;
+    }
+    return false;
+}
+
 CameraProviderManager::~CameraProviderManager() {
 }
 
