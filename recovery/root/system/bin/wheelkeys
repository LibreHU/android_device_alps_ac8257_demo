#!/system/bin/sh
# wheelkeys - UJC201 : touches au volant (MCU Jancar, trame 0x20) -> touches TWRP
#   touchfix lit l'appui sur /dev/ttyS1, l'ecrit dans /tmp/mcu_key ("seq canal v1 v2 v3 v4"),
#   cherche la touche dans la table et l'envoie sur le peripherique uinput "ujc201-wheel".
#
#   wheelkeys learn   apprentissage : appuyer sur chaque touche quand la fenetre le demande (10 s, sinon sautee)
#   wheelkeys show    table active + dernieres trames de touches recues
#   wheelkeys clear   supprime la table apprise
#
# Table : /data/media/0/TWRP/ujc201_keys.conf si /data est monte, sinon /tmp/ujc201_keys.conf (perdue au
# redemarrage) ; par defaut /system/etc/ujc201_keys.conf. Relue par touchfix a chaque modification.
# Ligne : <canal> <octet 1..4> <min> <max> <action> [nom]
#   actions : volup voldown enter back home power up down left right bl+ bl- none
#   Navigation dans TWRP (tools/keynav) : voldown / volup = element suivant / precedent, up / down / left / right =
#   element voisin, enter = appui (glissiere : deux fois), back = page precedente, home = menu principal,
#   power = verrouillage, bl+/bl- = luminosite

KEYS="VOL+:volup VOL-:voldown MUTE:enter MODE:home BACK:back PREV:up NEXT:down"
P=/tmp/wheelkeys.prompt
DATA=/data/media/0/TWRP/ujc201_keys.conf

say() { printf '%s\t%s\n' "$1" "$2" > $P; echo "$2"; }

table() {
	for f in $DATA /tmp/ujc201_keys.conf /system/etc/ujc201_keys.conf; do
		[ -f "$f" ] && { echo "$f"; return; }
	done
}

learn() {
	dest=/tmp/ujc201_keys.conf
	if [ -d /data/media/0 ]; then mkdir -p /data/media/0/TWRP && dest=$DATA; fi
	new=/tmp/ujc201_keys.new
	{
		echo "# ujc201_keys.conf - wheelkeys learn, $(date '+%Y-%m-%d %H:%M')"
		echo "# <canal> <octet 1..4> <min> <max> <action> [nom]"
	} > $new
	n=0; k=0; seen=""; tot=$(set -- $KEYS; echo $#)
	for kv in $KEYS; do
		name=${kv%%:*}; act=${kv#*:}; k=$((k + 1))
		last=$(cut -d' ' -f1 /tmp/mcu_key 2>/dev/null)
		say "Wheel keys: press $name ($k/$tot)" "Learning steering wheel keys - 10 s per key, else skipped"
		i=0; got=""
		while [ $i -lt 50 ]; do
			sleep 0.2; i=$((i + 1))
			cur=$(cut -d' ' -f1 /tmp/mcu_key 2>/dev/null)
			if [ -n "$cur" ] && [ "$cur" != "$last" ]; then got=1; break; fi
		done
		if [ -z "$got" ]; then echo "  $name : skipped"; continue; fi
		read seq ch b1 b2 b3 b4 < /tmp/mcu_key
		case $ch in
			1|2) idx=2; tol=0 ;;                                   # telecommande IR / molette : code exact
			5|6) idx=2; [ "$b2" = 255 ] && idx=3; tol=3 ;;         # volant (resistances) : octet utile
			*)   idx=1; tol=3 ;;                                   # touches AD (canaux 3/4)
		esac
		eval v=\$b$idx
		lo=$((v - tol)); [ $lo -lt 0 ] && lo=0
		hi=$((v + tol)); [ $hi -gt 254 ] && hi=254
		case " $seen " in *" $ch:$v "*) echo "  ATTENTION : $name donne la meme valeur qu'une touche precedente" ;; esac
		seen="$seen $ch:$v"
		echo "$ch $idx $lo $hi $act $name" >> $new
		echo "  $name : canal $ch, octet $idx = $v -> $act"
		n=$((n + 1))
		sleep 1
	done
	rm -f $P
	if [ $n -eq 0 ]; then
		rm -f $new; echo "Aucune touche recue (le MCU n'envoie pas de trame 0x20 : volant non cable, ou boitier CAN ?)"
		echo "Voir /tmp/mcu.log (lignes 'rx ee fa .. 20 ...')"; return 1
	fi
	mv $new $dest && echo "Table ecrite : $dest ($n touches)"
	[ "$dest" = /tmp/ujc201_keys.conf ] && echo "(/data non monte : table perdue au redemarrage)"
	return 0
}

show() {
	f=$(table)
	if [ -n "$f" ]; then echo "Table : $f"; grep -v '^#' "$f" | grep -v '^$' || echo "  (vide)"; else echo "Table : aucune"; fi
	echo "Derniere touche : $(cat /tmp/mcu_key 2>/dev/null || echo aucune)   (seq canal v1 v2 v3 v4)"
	echo "Trames 0x20 recues :"
	grep '^rx ee fa .. 20 ' /tmp/mcu.log 2>/dev/null | tail -n 12 || echo "  aucune"
}

case "$1" in
	learn) learn ;;
	clear) rm -f $DATA /tmp/ujc201_keys.conf; echo "Table apprise supprimee" ;;
	*) show ;;
esac
