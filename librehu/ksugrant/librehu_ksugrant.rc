#
# Root de KernelSU Next accorde d'office a toutes les applis LibreHU (voir librehu_ksugrant.c) : tous les paquets
# org.librehu.* installes (service, LibreHU Apps, Launcher, FM, Dialer, Widgets, BtnRemap, EasySource, Disc, Android Auto,
# CarPlay, Bridge, Helper...) et ViPER4Android (com.llsl.viper4android). KernelSU n'affiche pas de demande : sans profil,
# une appli est refusee en silence. Un choix fait dans le gestionnaire (refus compris) est garde ; une appli installee
# plus tard l'est au demarrage suivant.
on property:sys.boot_completed=1
    start librehu_ksugrant

service librehu_ksugrant /system/bin/librehu_ksugrant org.librehu.* com.llsl.viper4android
    class late_start
    user root
    group root
    oneshot
    disabled
