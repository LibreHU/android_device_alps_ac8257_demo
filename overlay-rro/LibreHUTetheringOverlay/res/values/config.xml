<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Point d'acces Wi-Fi : valeurs par defaut du module (Android 11) + ap\\d du pilote MediaTek gen4m (ap0) -->
    <string-array name="config_tether_wifi_regexs" translatable="false">
        <item>wlan\\d</item>
        <item>softap\\d</item>
        <item>ap\\d</item>
    </string-array>
    <!-- Bluetooth : bt-pan (defaut) + bt-dun, comme le RRO MediaTek -->
    <string-array name="config_tether_bluetooth_regexs" translatable="false">
        <item>bt-pan</item>
        <item>bt-dun</item>
    </string-array>
</resources>
